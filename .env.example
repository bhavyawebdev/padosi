# LocalPulse — Supabase configuration (copy to .env and fill in)
#
# Find these in the Supabase dashboard:
#   Project Settings → API → Project URL            → VITE_SUPABASE_URL
#   Project Settings → API → anon public key        → VITE_SUPABASE_ANON_KEY
#
# The anon key is safe for the browser. NEVER put the service_role key here
# — it is only used by the dev seed script (scripts/seed-supabase.mjs) via
# SUPABASE_SERVICE_ROLE_KEY, and never shipped to the browser.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Dev-only seed (npm run seed:supabase) — keep out of the browser build.
# The seed reuses VITE_SUPABASE_URL above; it only needs the service-role key
# here (Settings → API → service_role).
SUPABASE_SERVICE_ROLE_KEY=
