# Aas-Paas Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local — it is in .gitignore.

# ============================================================
# SUPABASE (Required)
# Get from: Supabase Dashboard → Project Settings → API
# ============================================================
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ============================================================
# APP URL (Required for production)
# Set to your Vercel deployment URL in production.
# ============================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============================================================
# CRON SECRET (Required for the scheduled cleanup cron)
# A long random string. The Vercel cron sends it as a Bearer token;
# requests without it are rejected. Never put this in NEXT_PUBLIC_*.
# ============================================================
CRON_SECRET=

# ============================================================
# EMAIL VALIDATION (Optional — signup spam protection)
# Local syntax + disposable-domain checks always run. Add a provider
# (e.g. ZeroBounce) for MX/domain verification on top:
#   EMAIL_VALIDATION_API_URL=https://api.zerobounce.net/v2/validatewithip
#   EMAIL_VALIDATION_API_KEY=your_provider_key
# Provider must accept POST JSON { email } and return { valid: bool }.
# On provider outage the default policy FAILS OPEN (signups still work).
# Set EMAIL_VALIDATION_FAIL_OPEN=false to block signups during outages.
# ============================================================
EMAIL_VALIDATION_API_URL=
EMAIL_VALIDATION_API_KEY=
EMAIL_VALIDATION_FAIL_OPEN=true

# ============================================================
# GOOGLE OAUTH
# Google OAuth is configured in the Supabase Dashboard, NOT here.
# Go to: Supabase Dashboard → Authentication → Providers → Google
# Add your Google Client ID and Client Secret there.
# No frontend env vars are needed for Google OAuth.
# ============================================================
# GOOGLE_CLIENT_ID=        (configured in Supabase Dashboard)
# GOOGLE_CLIENT_SECRET=    (configured in Supabase Dashboard)

# ============================================================
# MAPBOX (Optional — NOT required for MVP)
# Only add this if you add a map UI in V1.1.
# The core location engine works WITHOUT Mapbox.
# ============================================================
# NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=

# ============================================================
# SMS / PHONE OTP (Optional — NOT required for MVP)
# Add when you enable phone verification in a future release.
# ============================================================
# SMS_PROVIDER_API_KEY=
# SMS_PROVIDER_SENDER_ID=

# ============================================================
# TRANSACTIONAL EMAILS (Optional)
# Supabase Auth sends verification/reset emails itself — never duplicate
# those. These vars configure the optional *product* email provider
# (welcome email, security alerts). Default EMAIL_PROVIDER=noop logs instead
# of sending.
# ============================================================
EMAIL_PROVIDER=noop
# EMAIL_PROVIDER=resend   → set RESEND_API_KEY
# EMAIL_PROVIDER=http     → POST JSON { to, subject, text, html } with Bearer key
EMAIL_API_URL=
EMAIL_API_KEY=
# RESEND_API_KEY=

# ============================================================
# ADMIN
# The admin panel (/admin) requires an authenticated profile whose role is
# admin or super_admin (stored in the profiles table). No extra env vars.
# To promote the first admin, run in Supabase SQL editor:
#   UPDATE public.profiles SET role = 'super_admin' WHERE id = '<auth user id>';
# ============================================================

# ============================================================
# SECURITY NOTES
# - SUPABASE_SERVICE_ROLE_KEY and CRON_SECRET must NEVER be exposed
#   to the browser or placed in NEXT_PUBLIC_* variables
# - Never hard-code secrets in source code
# - Never commit this file with real values
# - Rotate keys immediately if accidentally committed
# ============================================================
