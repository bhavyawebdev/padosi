# Production environment example for docker compose.
# Copy this to backend/.env and replace all secret values.

APP_ENV=production
CORS_ORIGINS=["http://localhost:4173"]
SEED_DEMO_DATA=false

DATABASE_URL=postgresql+asyncpg://localpulse:localpulse@db:5432/localpulse
REDIS_URL=redis://redis:6379/0

JWT_SECRET=replace-with-a-generated-secret
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=10080

DEFAULT_RADIUS_KM=3.0
FEED_EXPIRY_HOURS_DEFAULT=12
VERIFIED_REVIEW_THRESHOLD=3
POST_RATE_LIMIT_PER_HOUR=10
