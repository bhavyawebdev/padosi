[TEMPLATE]
# Copy to .env and adjust. Never commit real secrets.

# Application
APP_ENV=development
CORS_ORIGINS=["http://localhost:5173"]
SEED_DEMO_DATA=true

# Database (PostgreSQL + PostGIS).
# Placeholder creds — replace with your local Postgres credentials.
# Ensure the database exists and PostGIS is enabled (see docs/ARCHITECTURE.md).
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/localpulse

# Redis (cache, Celery broker, WS pub/sub). App degrades to in-memory fallbacks
# in dev when Redis is unreachable — start it for full behaviour.
REDIS_URL=redis://localhost:6379/0

# Auth — generate a real secret with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-change-me
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=10080

# Feature defaults
DEFAULT_RADIUS_KM=3.0
FEED_EXPIRY_HOURS_DEFAULT=12
VERIFIED_REVIEW_THRESHOLD=3
POST_RATE_LIMIT_PER_HOUR=10
